# --- Бот в OceanGram ---
BOT_TOKEN=
# Адрес Bot API OceanGram (совместим с Telegram Bot API)
API_BASE=https://oceanment.space
# Ссылки на бота (для чеков): <LINK_BASE>/<username>?start=...
LINK_BASE=https://t.me
# ID админов через запятую: выпуск монет, споры P2P, статистика
ADMIN_IDS=

# --- Курсы ---
# Цена 1 звезды OceanGram в долларах (курсы показываются в звёздах)
STAR_PRICE_USD=0.015
# Цена GRAM в $, если его нет на CoinGecko (или ID монеты на CoinGecko)
GRAM_PRICE_USD=0.005
GRAM_COINGECKO_ID=
RATES_TTL=60

# --- Комиссии, % ---
SWAP_FEE_PERCENT=1
P2P_FEE_PERCENT=0

# --- P2P ---
P2P_PAY_MINUTES=15
P2P_DISPUTE_AFTER_MINUTES=5

DB_PATH=data/rocket.db
