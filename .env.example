# --- Telegram бот (@BotFather) ---
BOT_TOKEN=
# ID администраторов через запятую (команды /grant, /stats)
ADMIN_IDS=

# --- Мини-апп ---
WEBAPP_URL=https://jsqvpn.online
WEB_HOST=0.0.0.0
WEB_PORT=8080

# --- Мониторинг подарков (MTProto, аккаунт-сканер) ---
# api_id / api_hash: https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Строка сессии: python -m scripts.create_session
TG_SESSION=
# Сколько коллекций проверять параллельно и пауза между кругами (сек)
SCAN_CONCURRENCY=4
SCAN_INTERVAL=2
# Как долго кэшировать флор коллекции (сек)
FLOOR_CACHE_TTL=120

# --- xRocket Pay (@xRocket -> Rocket Pay -> Создать приложение -> API токен) ---
# Нужен токен приложения версии legacy (короткая строка, не JWT)
XROCKET_API_KEY=
XROCKET_WEBHOOK_SECRET=
XROCKET_CURRENCY=USDT

# --- Поиск свободных юзернеймов ботов (ai, game, app, agent, bot) ---
USERNAME_HUNTER=1
USERNAME_CHECK_INTERVAL=4
# Находки приходят админам (ADMIN_IDS) сводкой раз в N минут, с оценкой не ниже
USERNAME_ADMIN_MIN_SCORE=0
USERNAME_DIGEST_MINUTES=1

# --- Хранилище ---
DB_PATH=data/upgrade_gift.db
